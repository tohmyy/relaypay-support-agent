# Copy to .env.local (git-ignored) for development. Set production values only in the
# hosting provider's environment settings. Never commit real values.
# See docs/ENVIRONMENT.md.

# --- Public (safe to expose to the browser) ---
NEXT_PUBLIC_APP_URL=
# Optional: 1 plays a scripted demo conversation instead of a real call.
NEXT_PUBLIC_VOICE_MOCK=
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# --- Server-only secrets ---
VAPI_API_KEY=
VAPI_ASSISTANT_ID=

ANTHROPIC_API_KEY=
# Voice server (Vapi). AGENT_API_TOKEN protects the custom-LLM endpoint; VAPI_WEBHOOK_SECRET protects the webhook.
AGENT_API_TOKEN=
VAPI_WEBHOOK_SECRET=
# Optional: AGENT_PORT (default 4100), AGENT_HOST (default 127.0.0.1), AGENT_PUBLIC_URL (public URL for vapi:setup).
AGENT_PORT=
AGENT_HOST=
AGENT_PUBLIC_URL=
# Session lifecycle, in seconds (read by the agent service and the web state API; blank = default).
# SESSION_MAX_SECONDS: absolute AI voice session limit (360). SESSION_WARNING_SECONDS: warning before it (30).
# SILENCE_TIMEOUT_SECONDS: quiet time before the countdown shows (15). SILENCE_COUNTDOWN_SECONDS: countdown length (10).
SESSION_MAX_SECONDS=
SESSION_WARNING_SECONDS=
SILENCE_TIMEOUT_SECONDS=
SILENCE_COUNTDOWN_SECONDS=
# Latency (docs/PERFORMANCE.md). ACK_AFTER_MS: spoken acknowledgement if a reply is not ready after this long (2500).
# AGENT_PREWARM=1 keeps an agent process started per live call; leave it off until a measured comparison shows it helps.
# PREWARM_MAX: most warm processes at once (8). PREWARM_TTL_SECONDS: close an unused one after this long (90).
ACK_AFTER_MS=
AGENT_PREWARM=
PREWARM_MAX=
PREWARM_TTL_SECONDS=
# Interruption and noise tuning, read by npm run vapi:setup (docs/VAPI.md). Leave blank to keep the assistant as configured.
# INTERRUPT_NUM_WORDS 0-10, INTERRUPT_VOICE_SECONDS 0-0.5, INTERRUPT_BACKOFF_SECONDS 0-10, START_WAIT_SECONDS 0-5, SMART_DENOISING 0 or 1.
INTERRUPT_NUM_WORDS=
INTERRUPT_VOICE_SECONDS=
INTERRUPT_BACKOFF_SECONDS=
START_WAIT_SECONDS=
SMART_DENOISING=
# Optional model override for the agent (default claude-sonnet-5-5).
AGENT_MODEL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the sign-in cookie (docs/AUTH.md). At least 32 random characters, for example: openssl rand -base64 48
SESSION_SECRET=
MCP_SERVER_URL=
MCP_SERVER_AUTH_TOKEN=
# Optional MCP server bind settings (defaults: 4000 and 127.0.0.1).
MCP_PORT=
MCP_HOST=

# --- Database tooling only (npm run db:migrate / db:seed / db:seed-users); not read by the app ---
# Postgres connection string from the Supabase dashboard (Project Settings > Database).
SUPABASE_DB_URL=
# Optional: lets db:verify confirm the anon key cannot read the tables.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Shared password for the demo accounts created by npm run db:seed-users (10+ characters). Never commit a real one.
DEMO_USER_PASSWORD=
